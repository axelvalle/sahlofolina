{
  "name": "sahlo-folina-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:sync": "node scripts/sync-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "verify": "npm run content:sync && npm run content:validate && node --test tests/security.test.mjs",
    "dev": "next dev",
    "prebuild": "npm run verify",
    "build": "next build",
    "start": "next start",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start",
    "test": "node --test tests/security.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "10.8.0",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
